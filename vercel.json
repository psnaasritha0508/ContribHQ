{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "server",
      "framework": null,
      "buildCommand": "npx prisma generate --schema=../prisma/schema.prisma && tsup src/index.ts --out-dir dist --format cjs --no-splitting",
      "entrypoint": "dist/index.js"
    },
    "web": {
      "root": "web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "INTERNAL_SERVER_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
