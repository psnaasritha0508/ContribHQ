{
  "name": "contribhq",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@contribhq/server",
    "dev:web": "npm run dev --workspace=@contribhq/web",
    "dev": "concurrently -n \"server,web\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:web\"",
    "build:server": "npm run build --workspace=@contribhq/server",
    "build:web": "npm run build --workspace=@contribhq/web",
    "build": "npm run build:server && npm run build:web",
    "prisma:generate": "npx prisma generate",
    "seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prisma": "^5.16.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
